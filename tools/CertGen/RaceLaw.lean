import CertGen.Gen
import CatsEffectInLean.Props.Phase6.Race

/-! Generate the certificates of `GenSpawnLaws.uncancelableRaceNotInherited` (both sides).
Run from the repository root:
`lake env lean --run tools/CertGen/RaceLaw.lean` (with `tools` on `LEAN_PATH`, see the
raw note). -/

open CatsEffectInLean.Model CatsEffectInLean.Props.Phase6.Race

def hdr : String :=
  "/-! Generated by `tools/CertGen/RaceLaw.lean` (untrusted; checked by `CertP.certOnly` in\n" ++
  "`Proofs/Phase6/RaceLaw.lean`). Do not edit. -/\n"

def main : IO Unit := do
  let n ← CertGen.writeCert {} counterMaskModel lawEnv raceNotInheritedLhs
    "CatsEffectInLean/Proofs/Phase6/RaceLawCertLhs.lean" hdr
    "CatsEffectInLean.Proofs.Phase6.RaceLawCertLhs"
  IO.println s!"lhs states: {n}"
  let m ← CertGen.writeCert {} counterMaskModel lawEnv Timeout.neverIO
    "CatsEffectInLean/Proofs/Phase6/RaceLawCertRhs.lean" hdr
    "CatsEffectInLean.Proofs.Phase6.RaceLawCertRhs"
  IO.println s!"rhs states: {m}"

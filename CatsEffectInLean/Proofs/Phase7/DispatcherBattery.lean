  have := (hs u id false true 1 .unit xs1 (hyp_xs1 1 (by decide)) 230 [] 0).1; omega

/-! ## Statement 2: `dispAwaitDrains` (CE-0091) -/

theorem awaitDrains_sat : Hyp id 1 xs0 u ∧
    (run id false true 1 .unit xs0 u 200 [] 0).halt = some (.done (.succeeded .unit)) ∧
    status (run id false true 1 .unit xs0 u 200 [] 0) 0 = 2 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R01.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact ⟨hyp_xs0 1 (by decide), h.1, h.2.1⟩

/-- The status-0 break of statement 2 for the input `pureInp [0] ms [] p p`. -/
theorem drains_break (v N : Nat) (par : Bool) (ms : List Nat) (cs : List PChoice)
    (hh : Hyp id 1 (pureInp (List.replicate ms.length 0) ms [] p p) u) (hm : ms.length = 1)
    (hd : (run id par true 1 .unit (pureInp (List.replicate ms.length 0) ms [] p p) u N cs v).halt =
      some (.done (.succeeded .unit)))
    (hs : status (run id par true 1 .unit (pureInp (List.replicate ms.length 0) ms [] p p) u N cs v) 0 = 0) :
    ¬ dispAwaitDrainsV v := by
  intro h
  have := (h u id par 1 .unit ms hh N cs _ hd).2 0 (by omega)
  exact absurd (this.symm.trans hs) (by decide)


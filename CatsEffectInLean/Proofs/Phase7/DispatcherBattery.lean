  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R22.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 6 160 false [0] [0] (hyp_xcn 1 (by decide)) h
theorem noDeadlock_v10 : ¬ dispNoDeadlockV 10 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R14.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 10 119 false [1] [] (hyp_xs1 1 (by decide)) h
theorem noDeadlock_v14_seq : ¬ dispNoDeadlockV 14 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R08.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 14 12 false [0] [] (hyp_xs0 1 (by decide)) h
theorem noDeadlock_v14_par : ¬ dispNoDeadlockV 14 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R19.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 14 12 true [0] [] (hyp_xs0 1 (by decide)) h
theorem noDeadlock_v15 : ¬ dispNoDeadlockV 15 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R09.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 15 182 false [0] [] (hyp_xs0 1 (by decide)) h

/-- Variant 15 with `parallel` (no submission): no pill, the outer `Supervisor` joins the worker
forever. -/
theorem noDeadlock_v15_par : ¬ dispNoDeadlockV 15 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R20.obs
  simp only [beq_iff_eq] at h
  exact deadlock_break 15 157 true [] [] (hyp_of (pureInp [] [] [] p p) 1 (by decide) (by decide +kernel) (by decide) (by decide) rfl rfl) h


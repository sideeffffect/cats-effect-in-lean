/-! ## Statement 3: `dispNoLostSubmission` (CE-0090) -/

theorem noLost_sat : Hyp id 1 x90 u ∧
    (run id false true 1 .unit x90 u 203 [] 0).halt = some (.done (.succeeded .unit)) ∧
    status (run id false true 1 .unit x90 u 203 [] 0) 0 = 2 ∧
    rejected (run id false true 1 .unit x90 u 203 [] 0) 1 = 1 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R34.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact ⟨hyp_x90 1 (by decide), h⟩

/-- **CE-0090.** `parallel(await = true)`: a pure task from the body runs; the release waits for
it; the concurrent fiber's submission is accepted (no `IllegalStateException`) and never runs. -/
theorem dispNoLostSubmission_refuted : ¬ dispNoLostSubmission := by
  intro hs; have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R32.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h
  have := (hs u id true 1 .unit [0, 1] [0, 0] p (hyp_x90 1 (by decide)) (by decide) 386 (sched 14 300) _ h.1) 1
    (by decide)
  rcases this with hr | hst
  · exact absurd (hr.symm.trans h.2.2.2) (by decide)
  · exact absurd (hst.symm.trans h.2.2.1) (by decide)

/-- Fixed twin 32 of CE-0090 (decision 39) on the refuting input and schedule: both tasks run. -/
theorem noLost_twin32 :
    (run id true true 1 .unit x90 u 476 (sched 14 300) 32).halt = some (.done (.succeeded .unit)) ∧
    status (run id true true 1 .unit x90 u 476 (sched 14 300) 32) 0 = 2 ∧
    status (run id true true 1 .unit x90 u 476 (sched 14 300) 32) 1 = 2 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R33.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact h


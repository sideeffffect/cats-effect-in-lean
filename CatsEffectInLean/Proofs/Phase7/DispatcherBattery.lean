  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R15.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact drains_break 0 216 true [0] [] (hyp_xs0 1 (by decide)) rfl h.1 h.2.1


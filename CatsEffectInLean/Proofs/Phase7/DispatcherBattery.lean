theorem hyp_xlate (n : Nat) (hn : 1 ≤ n) : Hyp id n xlate u := hyp_of xlate n hn (by decide +kernel) (by decide) (by decide) rfl rfl
theorem hyp_xce : Hyp id 1 xce u := hyp_of xce 1 (by decide) (by decide +kernel) (by decide) (by decide) rfl rfl
theorem hyp_xsl (n : Nat) (hn : 1 ≤ n) : Hyp id n xsl u := hyp_of xsl n hn (by decide +kernel) (by decide) (by decide) rfl rfl
theorem hyp_xcan (n : Nat) (hn : 1 ≤ n) : Hyp id n xcan u := hyp_of xcan n hn (by decide +kernel) (by decide) (by decide) rfl rfl

/-! ## Statement 1: `dispRunsOnce` -/

theorem runsOnce_sat : Hyp id 1 xs0 u ∧ runs (run id false true 1 .unit xs0 u 200 [] 0) 0 = 1 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R01.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact ⟨hyp_xs0 1 (by decide), h.2.2⟩

theorem runsOnce_v4 : ¬ dispRunsOnceV 4 := by
  intro hs; have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R04.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h
  have := (hs u id false true 1 .unit xs0 (hyp_xs0 1 (by decide)) 230 [] 0).1; omega

theorem runsOnce_v12 : ¬ dispRunsOnceV 12 := by

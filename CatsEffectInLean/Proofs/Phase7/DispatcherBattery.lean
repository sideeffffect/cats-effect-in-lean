/-- A blocked run breaks statement 7. -/
theorem deadlock_break (v N : Nat) (par : Bool) (ms cn : List Nat)
    (hh : Hyp id 1 (pureInp (List.replicate ms.length 0) ms cn p p) u)
    (hb : (run id par true 1 .unit (pureInp (List.replicate ms.length 0) ms cn p p) u N [] v).halt = some .blocked) :
    ¬ dispNoDeadlockV v := fun h => h u id par true 1 .unit ms cn hh N [] hb

theorem noDeadlock_v2 : ¬ dispNoDeadlockV 2 := by
  have h := CatsEffectInLean.Proofs.Phase7.DispatcherRuns.R07.obs; simp only [Bool.and_eq_true, beq_iff_eq, and_assoc] at h; exact deadlock_break 2 119 false [0] [] (hyp_xs0 1 (by decide)) h
